# RuView ESPHome secrets — local credentials, NOT checked into git.
#
# 1. Copy this file:
#       cp secrets.yaml.example secrets.yaml
# 2. Edit secrets.yaml with your real WiFi creds + generate keys (below)
# 3. The .gitignore already excludes secrets.yaml

# WiFi credentials (must match the mesh the Pi is on)
wifi_ssid:     "Firefly"
wifi_password: "REPLACE_ME"

# ESPHome native-API encryption key. Generate with:
#   openssl rand -base64 32
api_encryption_key: "REPLACE_ME_32_BYTE_BASE64"

# OTA password — used by ESPHome to authorize OTA flashes.
# Generate with:  openssl rand -hex 16
ota_password: "REPLACE_ME_HEX"

# MQTT broker host (typically the Orange Pi IP — mosquitto runs there).
mqtt_broker_host: "192.168.7.205"
